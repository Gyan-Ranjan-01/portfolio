  <section id="home" class="active">
    <div class="bg-animation">
      <div class="bg-circle bg-circle-1"></div>
      <div class="bg-circle bg-circle-2"></div>
    </div>
    <div class="hero-content">
      <div class="profile-img">
        <div class="profile-img-inner"><img src="/img/profile.png" alt="👤"  ></div>
      </div>
      <h1>Gyan Ranjan</h1>
      <p class="tagline">
        Full Stack Developer | Competitive Programmer | Passionate to learn ML
      </p>
      <p class="bio">
        I am a Full Stack Developer who believes in writing clean, deployable
        code. I am proficient in the MERN Stack. Beyond
        development, I am deeply invested in sharpening my problem-solving
        skills. I am an active Competitive Programmer with a rating of 1000+
        on Codeforces.
      </p>
      <div class="social-links">
        <a href="https://github.com/gyan-ranjan-01" class="social-btn" target="_blank" rel="noopener noreferrer"><i
            class="fa-brands fa-github"></i></a>
        <a href="https://www.linkedin.com/in/gyan-ranjan-025a611bb/" class="social-btn" target="_blank"
          rel="noopener noreferrer"><i class="fa-brands fa-linkedin"></i></a>
        <a href="mailto:rgyan2748@gmail.com" class="social-btn" target="_blank" rel="noopener noreferrer"><i
            class="fa-solid fa-envelope"></i></a>
      </div>
      <a href="/projects" class="cta-btn">View My Work</a>
      <!-- <div class="scroll-arrow">↓</div> -->
    </div>
  </section>

  <section id="about">
    <div class="container">
      <h2 class="section-title">About Me</h2>
      <div class="about-grid">
        <div class="about-card">
          <div class="icon">👤</div>
          <h3>Who I Am</h3>
          <p>
            I am currently in B. Tech 1st year of department of Information
            Technology in IIEST, Shibpur. I have completed my Higher Secondary
            from Central Hindu Boys School, Varanasi.
          </p>
        </div>
        <div class="about-card">
          <div class="icon">💻</div>
          <h3>What I Do</h3>
          <p>Full Stack Developer</p>
        </div>
        <div class="about-card">
          <div class="icon">🎯</div>
          <h3>My Goals</h3>
          <p>Building a career in Full Stack Development</p>
        </div>
      </div>

      <h3 style="color: #0ff; font-size: 2rem; margin: 3rem 0 2rem">
        🏆 Achievements
      </h3>
      <div class="timeline-item">
        <h4>[Achievement Title]</h4>
        <span class="company">[Year] • [Organization]</span>
        <p>[Description]</p>
      </div>

      <h3 style="color: #0ff; font-size: 2rem; margin: 3rem 0 2rem">
        💼 Experience
      </h3>
      <div class="timeline-item">
        <h4>[Job Title]</h4>
        <span class="company">[Company] • [Duration]</span>
        <p>[What you did]</p>
      </div>
    </div>
  </section>

